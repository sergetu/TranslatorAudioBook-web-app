@echo off
rem ============================================================
rem Запуск API-сервера (FastAPI/uvicorn), порт 8090, LAN.
rem Диспетчер очереди (перевод/озвучка) стартует вместе с сервером.
rem Фронт раздаётся из web\dist (соберите run\06_build_web.cmd один раз).
rem ============================================================
setlocal
cd /d "%~dp0.."
python -m uvicorn app.main:app --host 0.0.0.0 --port 8090
endlocal
